{
  "purpose": "Build input for the OpenAI submission ZIP's mcp.json OAuth extension. Not a native-client manifest. Verify portal validation and actual consent scopes before submission.",
  "url": "https://fusionmetrics.com/api/mcp",
  "auth": {
    "type": "oauth",
    "client": {
      "mode": "dcr"
    },
    "resource": "https://fusionmetrics.com/api/mcp",
    "oidcEnabled": true,
    "baseScopes": [
      "openid",
      "email",
      "user:org:read",
      "setup:read",
      "setup:write",
      "analytics:read"
    ],
    "defaultScopes": [
      "openid",
      "email",
      "user:org:read",
      "setup:read",
      "setup:write",
      "analytics:read"
    ]
  }
}
